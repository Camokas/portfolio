---
import Doodle from "../ui/Doodle.astro";
import { directions } from "../../data/directions";
interface Props { activeDirections?: string[]; }
const { activeDirections } = Astro.props;
const catalogDirections = directions.filter(direction => direction.slug !== "software" && (!activeDirections || activeDirections.includes(direction.slug)));
---

<project-catalog>
	<form class="catalog-controls" hidden role="search" aria-label="Search projects">
		<label class="search-field">Search
			<input type="search" name="q" placeholder="Title, description or tags" />
		</label>
		<label>Direction
			<select name="direction">
				<option value="">All directions</option>
				{catalogDirections.map((direction) => <option value={direction.slug}>{direction.title}</option>)}
			</select>
		</label>
		<label>Sort
			<select name="sort">
				<option value="best">Best first</option>
					<option value="newest">Newest first</option>
				<option value="oldest">Oldest first</option>
				<option value="title">Title A–Z</option>
			</select>
		</label>
		<button type="reset">Reset</button>
	</form>
	<p class="catalog-results" data-results role="status" hidden></p>
	<slot />
	<div class="no-results" data-empty hidden><Doodle name="zzz" width={72} flow /><p>No matching projects. Try another search or reset the filters.</p></div>
</project-catalog>

<script>
	import { translateExact } from "../../data/translations";
	class ProjectCatalogElement extends HTMLElement {
		cleanup?: () => void;
		connectedCallback() {
			const form = this.querySelector<HTMLFormElement>("form");
			const search = form?.querySelector<HTMLInputElement>('[name="q"]');
			const direction = form?.querySelector<HTMLSelectElement>('[name="direction"]');
			const sort = form?.querySelector<HTMLSelectElement>('[name="sort"]');
			const results = this.querySelector<HTMLElement>("[data-results]");
			const empty = this.querySelector<HTMLElement>("[data-empty]");
			const cards = [...this.querySelectorAll<HTMLElement>("[data-project-card]")];
			if (!form || !search || !direction || !sort || !results || !empty) return;
			const normalize = (value: string) => value.normalize("NFKC").toLocaleLowerCase().trim();
			const searchIndex = new Map(cards.map((card) => [card, normalize(card.dataset.search ?? "")]));
			const apply = (writeUrl = true) => {
				const language = document.documentElement.lang === "ru" ? "ru" : "en";
				const collator = new Intl.Collator(language, { numeric: true, sensitivity: "base" });
				const terms = normalize(search.value).split(/\s+/).filter(Boolean);
				const ordered = [...cards].sort((a, b) => {
					if (sort.value === "title") return collator.compare(translateExact(a.dataset.title ?? "", language), translateExact(b.dataset.title ?? "", language));
					if (sort.value === "best") return Number(a.dataset.rank ?? 9999) - Number(b.dataset.rank ?? 9999);
						const difference = Number(a.dataset.date) - Number(b.dataset.date);
					return sort.value === "oldest" ? difference : -difference;
				});
				let visible = 0;
				ordered.forEach((card) => {
					card.hidden = Boolean(direction.value && card.dataset.direction !== direction.value)
						|| !terms.every((term) => searchIndex.get(card)?.includes(term));
					if (!card.hidden) visible++;
					card.parentElement?.append(card);
				});
				results.textContent = `${visible} of ${cards.length} projects`;
				empty.hidden = visible > 0 || cards.length === 0;
				if (writeUrl) {
					const url = new URL(window.location.href);
					for (const [key, value] of [["q", search.value.trim()], ["direction", direction.value], ["sort", sort.value === "best" ? "" : sort.value]]) {
						if (value) url.searchParams.set(key, value); else url.searchParams.delete(key);
					}
					history.replaceState(null, "", url);
				}
			};
			const restore = () => {
				const params = new URLSearchParams(location.search);
				search.value = params.get("q") ?? "";
					direction.value = params.get("direction") ?? "";
					if (!direction.value) direction.value = "";
					sort.value = params.get("sort") ?? "best";
					if (!sort.value) sort.value = "best";
					apply(false);
			};
			let timer: ReturnType<typeof setTimeout>;
			const update = () => { clearTimeout(timer); timer = setTimeout(() => apply(), 150); };
			form.addEventListener("input", update);
			form.addEventListener("submit", (event) => { event.preventDefault(); clearTimeout(timer); apply(); });
			form.addEventListener("reset", () => { clearTimeout(timer); setTimeout(() => apply(), 0); });
			window.addEventListener("popstate", restore);
			const languageChanged = () => { if (sort.value === "title") apply(false); };
			document.addEventListener("portfolio:language-change", languageChanged);
			this.cleanup = () => { clearTimeout(timer); window.removeEventListener("popstate", restore); document.removeEventListener("portfolio:language-change", languageChanged); };
			restore();
			form.hidden = false;
			results.hidden = false;
		}
		disconnectedCallback() { this.cleanup?.(); }
	}
	if (!customElements.get("project-catalog")) customElements.define("project-catalog", ProjectCatalogElement);
</script>

<style>
	project-catalog { display: block; }
	.no-results p { margin: 0; }
	.no-results[hidden] { display: none; }
	.no-results :global(.doodle) { opacity: 0.6; flex: none; }
	.catalog-controls { display: grid; grid-template-columns: minmax(12rem, 2fr) 1fr 1fr auto; align-items: end; gap: var(--space-3); margin: 0 0 var(--space-4); padding: var(--space-4); border: 1px solid var(--color-border); border-radius: var(--radius-md); background: var(--color-surface); }
	.catalog-controls[hidden], [hidden] { display: none; }
	label { display: grid; gap: var(--space-1); color: var(--color-faint); font-family: var(--font-mono); font-size: var(--text-label); }
	input, select, button { min-width: 0; min-height: 2.75rem; padding: 0.6rem 0.7rem; border: 1px solid var(--color-border-strong); border-radius: var(--radius-sm); background: var(--color-background); color: var(--color-text); font: inherit; font-size: var(--text-small); }
	input::placeholder { color: var(--color-faint); }
	button { cursor: pointer; transition: border-color 160ms var(--ease); }
	button:hover { border-color: var(--color-text); }
	input:focus-visible, select:focus-visible, button:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 0.2rem; }
	.catalog-results, .no-results { margin: 0 0 var(--space-4); color: var(--color-faint); font-family: var(--font-mono); font-size: var(--text-label); }
	.no-results { display: flex; align-items: center; gap: var(--space-4); padding: var(--space-5); border: 1px dashed var(--color-border-strong); border-radius: var(--radius-md); font-family: inherit; font-size: var(--text-small); color: var(--color-muted); }
	@media (max-width: 56rem) { .catalog-controls { grid-template-columns: repeat(2, minmax(0, 1fr)); } .search-field { grid-column: 1 / -1; } }
	@media (max-width: 30rem) { .catalog-controls { grid-template-columns: 1fr; } }
</style>
