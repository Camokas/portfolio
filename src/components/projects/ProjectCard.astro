---
import MediaPreview from "./MediaPreview.astro";
import ProjectDate from "./ProjectDate.astro";
import { projectPreviews } from "../../data/projectPreviews";
import type { CollectionEntry } from "astro:content";
import Icon from "../ui/Icon.astro";
import { directions } from "../../data/directions";
import { translateExact } from "../../data/translations";

interface Props {
	project: CollectionEntry<"projects">;
	/** "feature" shows the summary and a larger frame; "default" is title + meta only. */
	variant?: "default" | "feature";
	/** Editorial rank (0 = best). Used by the catalog's "Best first" sort. */
	rank?: number;
}

const { project, variant = "default", rank } = Astro.props;
const previews = await projectPreviews(project);
const direction = directions.find((item) => item.slug === project.data.direction);
const projectUrl = `${import.meta.env.BASE_URL}projects/${project.id}/`;
const englishSearch = `${project.data.title} ${project.data.summary} ${project.data.tags.join(" ")}`;
const russianSearch = [project.data.title, project.data.summary, ...project.data.tags]
	.map((value) => translateExact(value.trim(), "ru"))
	.join(" ");
---

<li class="project-item"
	data-project-card
	data-title={project.data.title}
	data-search={`${englishSearch} ${russianSearch}`}
	data-direction={project.data.direction}
	data-date={project.data.date.getTime()}
	data-rank={rank}
>
	<article class:list={["card", variant]}>
		<div class="thumb">
			{previews.length > 0 ? <MediaPreview items={previews} /> : (
				<div class="placeholder" aria-hidden="true">
					{direction && <Icon name={direction.icon} size={30} strokeWidth={1.4} />}
					<span class="glyphs">░▒▓█▓▒░</span>
				</div>
			)}
		</div>
		<div class="caption">
			<h3><a href={projectUrl} aria-label={`Open ${project.data.title}`}>{project.data.title}</a></h3>
			<p class="meta">
				<span class="dir">{direction?.title}</span>
				<ProjectDate date={project.data.date} dateEnd={project.data.dateEnd} approximate={project.data.dateApproximate} short />
				{project.data.demo && <span class="chip">Demo</span>}
			</p>
			{variant === "feature" && project.data.summary && <p class="summary">{project.data.summary}</p>}
		</div>
	</article>
</li>

<style>
	.project-item { min-width: 0; }

	.card {
		position: relative;
		display: flex;
		flex-direction: column;
		height: 100%;
		overflow: hidden;
		border: 1px solid var(--color-border);
		border-radius: var(--radius-md);
		background: var(--color-surface);
		transition: border-color 180ms var(--ease), box-shadow 180ms var(--ease), transform 180ms var(--ease);
	}

	.thumb {
		position: relative;
		flex: none;
		aspect-ratio: var(--thumb-ratio, 4 / 3);
		overflow: hidden;
		border-bottom: 1px solid var(--color-border);
		background: var(--color-surface-2);
	}
	.feature .thumb { aspect-ratio: 16 / 10; flex: 1 1 auto; min-height: 12rem; }
	.card.feature { min-height: 100%; }

	.thumb :global(media-preview) { transition: transform 500ms var(--ease); }

	.placeholder {
		position: absolute;
		inset: 0;
		display: grid;
		place-content: center;
		justify-items: center;
		gap: var(--space-3);
		color: var(--color-faint);
		background:
			radial-gradient(circle at 1px 1px, rgb(244 241 232 / 0.14) 1px, transparent 1.5px) 0 0 / 14px 14px,
			var(--color-surface-2);
	}
	.glyphs { font-family: var(--font-mono); letter-spacing: 0.2em; font-size: 0.9rem; opacity: 0.7; }

	.caption { display: grid; gap: var(--space-2); padding: 0.85rem 1rem 1rem; }

	h3 { margin: 0; font-size: var(--text-h3); line-height: 1.25; letter-spacing: -0.015em; font-weight: 650; }
	.feature h3 { font-size: clamp(1.2rem, 2.2vw, 1.6rem); }
	h3 a { color: var(--color-text); text-decoration: none; }
	/* The whole card is the link target. */
	h3 a::after { content: ""; position: absolute; inset: 0; z-index: 2; }
	h3 a:focus-visible { outline: none; }
	.card:has(h3 a:focus-visible) { outline: 2px solid var(--color-accent); outline-offset: 2px; }

	.meta {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.15rem var(--space-3);
		margin: 0;
		color: var(--color-faint);
		font-family: var(--font-mono);
		font-size: var(--text-label);
		line-height: 1.5;
	}
	.meta .dir { color: var(--color-muted); }
	.meta :global(.project-date) { color: inherit; }
	.chip { padding: 0 0.4rem; border: 1px solid var(--color-border-strong); border-radius: var(--radius-sm); }

	.summary {
		display: -webkit-box;
		margin: var(--space-1) 0 0;
		overflow: hidden;
		color: var(--color-muted);
		font-size: var(--text-small);
		line-height: 1.55;
		-webkit-line-clamp: 3;
		-webkit-box-orient: vertical;
	}

	@media (max-width: 36rem) {
		.card:not(.feature) .caption { padding: 0.6rem 0.7rem 0.75rem; gap: var(--space-1); }
		.card:not(.feature) h3 { font-size: 0.95rem; }
	}

	@media (hover: hover) {
		.card:hover {
			border-color: var(--color-border-strong);
			box-shadow: var(--glow);
			transform: translateY(-2px);
		}
		.card:hover .thumb :global(media-preview) { transform: scale(1.035); }
	}
	@media (prefers-reduced-motion: reduce) {
		.card:hover { transform: none; }
		.card:hover .thumb :global(media-preview) { transform: none; }
	}
</style>
