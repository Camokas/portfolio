---
import type { PreviewMedia } from "../../data/projectPreviews";
import { Code } from "astro:components";
interface Props { items: PreviewMedia[]; }
const { items } = Astro.props;
const first = items[0];
const initialImage = first?.kind === "image" || first?.kind === "shaderGraph" ? first.src : first?.poster;
---

<media-preview data-items={JSON.stringify(items)} aria-hidden="true">
	<div class="preview-layers">
		{initialImage && <img class:list={["slide", "active", { model: first.kind === "model", 'graph-preview': first.kind === 'shaderGraph' }]} src={initialImage} alt="" loading="lazy" decoding="async" />}
	</div>
	{items.map((item, index) => item.code && (
		<template data-preview-code={index}>
			<div class="code-preview">
				<Code code={item.code.code.trim().split("\n").slice(0, 28).join("\n")} lang={item.code.language} theme="github-dark" />
			</div>
		</template>
	))}
</media-preview>

<script>
	import "../../scripts/mediaPreview";
</script>

<style>
	media-preview { position: absolute; inset: 0; display: block; overflow: hidden; pointer-events: none; }
	.preview-layers { position: absolute; inset: 0; }
	media-preview :global(.slide) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0; }
	media-preview :global(.slide.active) { opacity: 1; }
	media-preview :global(.slide.model) { object-fit: contain; padding: 0.35rem; }
	media-preview :global(.slide.graph-preview) { object-fit: contain; background: #10161c; padding: 0.5rem; }
	media-preview :global(.slide.atlas-preview) { background: #111714; container-type: size; }
	media-preview :global(.atlas-preview canvas) {
		--sheet-width: max(145cqw, calc(145cqh * var(--atlas-ratio)));
		--sheet-height: max(145cqh, calc(145cqw / var(--atlas-ratio)));
		--pan-x: min(40cqw, calc((var(--sheet-width) - 100cqw) / 2));
		position: absolute; left: 50%; top: 50%;
		width: var(--sheet-width); height: var(--sheet-height); max-width: none;
		image-rendering: pixelated;
		transform: translate(-50%, -50%) rotate(-10deg);
		animation: atlas-drift var(--atlas-duration, 3500ms) linear infinite alternate;
		animation-play-state: paused;
	}
	media-preview[data-preview-running="true"] :global(.atlas-preview.active canvas) { animation-play-state: running; }
	@keyframes atlas-drift {
		from { transform: translate(-50%, -50%) rotate(-10deg) translateX(var(--pan-x)); }
		to { transform: translate(-50%, -50%) rotate(-10deg) translateX(calc(0px - var(--pan-x))); }
	}
	@media (prefers-reduced-motion: reduce) {
		media-preview :global(.atlas-preview canvas) { animation: none; }
	}
	media-preview :global(.slide.code-preview) { overflow: hidden; padding: 1rem; background: #0d1117; }
	media-preview :global(.code-preview pre) { margin: 0; padding: 0; background: transparent !important; font-size: 0.7rem; line-height: 1.65; white-space: pre; tab-size: 2; }
</style>
