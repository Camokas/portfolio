---
// Decorative hand-drawn sketch by the author. Purely visual, hidden from assistive tech.
// Position it with a class from the parent (it is absolutely positioned by default,
// or pass `flow` to keep it in the normal layout). Sizes come from src/data/doodles.ts.
import { doodles, type DoodleName } from "../../data/doodles";

interface Props {
	name: DoodleName;
	/** Rendered width in CSS pixels (height follows the drawing's ratio). */
	width?: number;
	class?: string;
	flow?: boolean;
	eager?: boolean;
}

const { name, width, class: className, flow = false, eager = false } = Astro.props;
const size = doodles[name];
const w = width ?? size.width;
const h = Math.round((w * size.height) / size.width);
const src = `${import.meta.env.BASE_URL}decor/${name}.webp`;
---

<img
	class:list={["doodle", `doodle-${name}`, { flow }, className]}
	src={src}
	width={w}
	height={h}
	alt=""
	aria-hidden="true"
	loading={eager ? "eager" : "lazy"}
	decoding="async"
	draggable="false"
/>

<style>
	.doodle {
		position: absolute;
		z-index: 0;
		height: auto;
		max-width: none;
		opacity: 0.4;
		pointer-events: none;
		user-select: none;
		-webkit-user-select: none;
	}
	.doodle.flow { position: relative; max-width: 100%; }

	@media print {
		.doodle { display: none; }
	}
</style>
