---
// One compact heading pattern for every section: mono index, title, optional link.
// Deliberately short: no kicker + giant title + paragraph stack.
import Icon from "./Icon.astro";
import Doodle from "./Doodle.astro";
import type { DoodleName } from "../../data/doodles";

interface Props {
	id?: string;
	index?: string;
	title: string;
	note?: string;
	href?: string;
	linkLabel?: string;
	level?: 1 | 2;
	/** Small hand-drawn mark next to the title. */
	accent?: DoodleName;
	accentWidth?: number;
	/** Hand-drawn arrow before the link. */
	linkAccent?: DoodleName;
}

const { id, index, title, note, href, linkLabel, level = 2, accent, accentWidth = 44, linkAccent } = Astro.props;
const Tag = level === 1 ? "h1" : "h2";
---

<div class="section-heading">
	<div class="text">
		{index && <p class="label index" aria-hidden="true">{index}</p>}
		<div class="title-row"><Tag id={id}>{title}</Tag>{accent && <Doodle name={accent} width={accentWidth} flow class="accent" />}</div>
		{note && <p class="note">{note}</p>}
	</div>
	<slot />
	{href && linkLabel && <div class="link-wrap">{linkAccent && <Doodle name={linkAccent} width={52} flow class="link-accent" />}<a class="link-arrow" href={href}>{linkLabel} <Icon name="arrow-right" size={16} /></a></div>}
</div>

<style>
	.section-heading {
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		flex-wrap: wrap;
		gap: var(--space-3) var(--space-5);
		margin-bottom: var(--space-5);
	}
	.title-row { display: flex; align-items: center; gap: var(--space-4); }
	.title-row :global(.accent) { opacity: 0.7; flex: none; }
	.link-wrap { display: flex; align-items: center; gap: var(--space-3); }
	.link-wrap :global(.link-accent) { opacity: 0.55; }
	@media (max-width: 36rem) { .link-wrap :global(.link-accent) { display: none; } }
	.text { display: grid; gap: var(--space-1); min-width: 0; }
	h1, h2 { margin: 0; font-size: var(--text-h2); line-height: 1.15; letter-spacing: -0.03em; }
	h1 { font-size: var(--text-h1); letter-spacing: -0.04em; }
	.note { margin: 0; max-width: var(--measure); color: var(--color-muted); font-size: var(--text-small); }
	.link-arrow :global(svg) { transition: transform 160ms var(--ease); }
	.link-arrow:hover :global(svg) { transform: translateX(0.2rem); }
</style>
