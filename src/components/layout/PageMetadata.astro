---
interface Props {
	title: string;
	description: string;
	lang: string;
	type?: "website" | "article";
	publishedAt?: Date;
	noindex?: boolean;
	image?: string;
}

const { title, description, lang, type = "website", publishedAt, noindex = false, image } = Astro.props;
const canonicalUrl = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
const imageUrl = Astro.site ? new URL(image ?? `${import.meta.env.BASE_URL}og-image.jpg`, Astro.site).href : undefined;
---

<meta name="description" content={description} />
<meta name="author" content="Daniil Doroshkin" />
<meta name="referrer" content="strict-origin-when-cross-origin" />
<meta name="theme-color" content="#0e0e0e" />
{noindex && <meta name="robots" content="noindex, follow" />}
{canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:type" content={type} />
<meta property="og:site_name" content="Camoka's Portfolio" />
<meta property="og:locale" content={lang === "en" ? "en_US" : lang.replace("-", "_")} />
{canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
{type === "article" && publishedAt && <meta property="article:published_time" content={publishedAt.toISOString()} />}
{imageUrl && <meta property="og:image" content={imageUrl} />}
{imageUrl && image === undefined && <meta property="og:image:width" content="1200" />}
{imageUrl && image === undefined && <meta property="og:image:height" content="630" />}
<meta name="twitter:card" content={imageUrl ? "summary_large_image" : "summary"} />
{imageUrl && <meta name="twitter:image" content={imageUrl} />}
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
