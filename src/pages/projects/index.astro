---
import ProjectCard from "../../components/projects/ProjectCard.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Icon from "../../components/ui/Icon.astro";
import Doodle from "../../components/ui/Doodle.astro";
import CatalogControls from "../../components/projects/CatalogControls.astro";
import { listProjects, rankMap } from "../../data/rankings";

const projects = await listProjects();
const ranks = rankMap(projects);
// Initial (no-JS) order is the editorial order; the catalog script re-sorts on demand.
const ordered = [...projects].sort(
	(a, b) => (ranks.get(a.id) ?? 9999) - (ranks.get(b.id) ?? 9999) || b.data.date.getTime() - a.data.date.getTime(),
);
---

<BaseLayout
	title="Projects | Camoka's Portfolio"
	description="Browse Camoka's creative and development projects."
	lang="en"
>
	<main class="container page" id="main-content" tabindex="-1">
		<nav class="crumbs" aria-label="Breadcrumb"><a href={import.meta.env.BASE_URL}><Icon name="arrow-left" size={15} /> Back to home</a></nav>
		<header>
			<div class="copy">
				<p class="label">Full archive</p>
				<h1>Projects</h1>
				<p class="description">Finished work, prototypes, studies, and experiments. Best work first; sort by date to see everything in order.</p>
			</div>
			<Doodle name="ducks" width={84} flow class="mark" />
		</header>

		<section aria-label="All projects">
			<CatalogControls activeDirections={[...new Set(projects.map((project) => project.data.direction))]}>
				{ordered.length > 0
					? <ul class="project-grid">{ordered.map((project) => <ProjectCard project={project} rank={ranks.get(project.id)} />)}</ul>
					: <p class="empty-message">Published projects will appear here.</p>}
			</CatalogControls>
		</section>
	</main>
</BaseLayout>

<style>
	.page { padding-block: var(--space-5) var(--space-8); }
	.crumbs a { display: inline-flex; align-items: center; gap: var(--space-1); color: var(--color-muted); font-size: var(--text-small); text-decoration: none; }
	.crumbs a:hover, .crumbs a:focus-visible { color: var(--color-text); text-decoration: underline; text-underline-offset: 0.25rem; }
	header { display: flex; align-items: flex-end; justify-content: space-between; gap: var(--space-5); padding-block: var(--space-6); margin-bottom: var(--space-5); border-bottom: 1px solid var(--color-border); }
	.copy { display: grid; gap: var(--space-2); }
	h1 { margin: 0; font-size: var(--text-h1); line-height: 1.05; letter-spacing: -0.045em; }
	.description { margin: 0; max-width: 38rem; color: var(--color-muted); font-size: var(--text-lead); }
	header :global(.mark) { opacity: 0.6; }
	.project-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 15.5rem), 1fr)); gap: var(--space-4); margin: 0; padding: 0; list-style: none; }
	@media (max-width: 36rem) { .project-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-3); } }
	.empty-message { padding: var(--space-5); border: 1px dashed var(--color-border-strong); border-radius: var(--radius-md); color: var(--color-muted); }
</style>
