---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ProjectDate from "../../components/projects/ProjectDate.astro";
import StoryPanel from "../../components/projects/StoryPanel.astro";
import ProjectGallery from "../../components/projects/ProjectGallery.astro";
import ProjectVideo from "../../components/projects/ProjectVideo.astro";
import ProjectAudio from "../../components/projects/ProjectAudio.astro";
import MusicPlayer from "../../components/projects/MusicPlayer.astro";
import AtlasViewer from "../../components/projects/AtlasViewer.astro";
import ProjectResources from "../../components/projects/ProjectResources.astro";
import ProjectCode from "../../components/projects/ProjectCode.astro";
import ProjectModels from "../../components/projects/ProjectModels.astro";
import RelatedProjects from "../../components/projects/RelatedProjects.astro";
import {
	getCollection,
	render,
	type CollectionEntry,
} from "astro:content";
import { directions } from "../../data/directions";
import Icon from "../../components/ui/Icon.astro";
import { Image } from "astro:assets";
import { directionDoodles } from "../../data/doodles";
import Doodle from "../../components/ui/Doodle.astro";
import Gallery from "../../components/projects/inline/Gallery.astro";
import Video from "../../components/projects/inline/Video.astro";
import Audio from "../../components/projects/inline/Audio.astro";
import Models from "../../components/projects/inline/Models.astro";
import Code from "../../components/projects/inline/Code.astro";
import Resources from "../../components/projects/inline/Resources.astro";
import Downloads from "../../components/projects/inline/Downloads.astro";
import Links from "../../components/projects/inline/Links.astro";
import ShaderGraph from "../../components/projects/inline/ShaderGraph.astro";
import ProjectShaderGraphs from "../../components/projects/ProjectShaderGraphs.astro";

export async function getStaticPaths() {
	const projects = await getCollection("projects", ({ data }) => !data.draft);

	return projects.map((project) => ({
		params: { id: project.id },
		props: { project },
	}));
}

interface Props {
	project: CollectionEntry<"projects">;
}

const { project } = Astro.props;
const { Content } = await render(project);
const inline = project.data.mediaLayout === "inline";
const mediaComponents = { StoryPanel, Gallery, Image: Gallery, Video, Audio, Models, Code, Resources, Downloads, Links, ShaderGraph, ShaderGraphs: ShaderGraph };
const direction = directions.find(
	(item) => item.slug === project.data.direction,
);

if (!direction) {
	throw new Error(`Unknown project direction: ${project.data.direction}`);
}

const baseUrl = import.meta.env.BASE_URL;
const directionUrl = `${baseUrl}directions/${direction.slug}/`;
const keyDoodle = directionDoodles[direction.slug];
const musicTrack = direction.slug === "music-sound" ? project.data.audio[0] : undefined;
const otherAudio = musicTrack ? project.data.audio.slice(1) : project.data.audio;
---

<BaseLayout
	title={`${project.data.title} | Camoka's Portfolio`}
	description={project.data.summary}
	lang="en"
	type="article"
	publishedAt={project.data.date}
	noindex={project.data.demo}
	image={project.data.cover?.src}
>
	<main class="project-page" id="main-content" tabindex="-1">
		<a class="back-link" href={directionUrl}>
			<Icon name="arrow-left" size={17} /> Back to {direction.title}
		</a>

		<article>
			<header class="project-header">
					<div class="intro">
						<p class="label"><a href={directionUrl}><Icon name={direction.icon} size={14} /> {direction.title}</a></p>
						<h1>{project.data.title}</h1>
						<p class="summary">{project.data.summary}</p>
						<dl class="facts">
							<div><dt>Period</dt><dd><ProjectDate date={project.data.date} dateEnd={project.data.dateEnd} approximate={project.data.dateApproximate} /></dd></div>
							{project.data.tags.length > 0 && (
								<div class="tags-row"><dt>Tags</dt><dd><ul aria-label="Project tags">{project.data.tags.map((tag) => <li>{tag}</li>)}</ul></dd></div>
							)}
						</dl>
						{project.data.demo && <span class="demo-label">Demo content</span>}
					</div>
					{project.data.cover && !musicTrack && (
						<figure class="key-preview">
							<Image src={project.data.cover} alt="" widths={[640, 1000, 1400]} sizes="(min-width: 56rem) 60vw, 100vw" loading="eager" />
						</figure>
					)}
					{keyDoodle && !project.data.cover && <Doodle name={keyDoodle} width={110} flow class="mark" />}
				</header>
			{musicTrack && <MusicPlayer track={musicTrack} cover={project.data.cover} />}
			{project.data.atlases.length > 0 && <AtlasViewer items={project.data.atlases} />}

			{
				!inline && project.data.gallery.length > 0 && (
					<ProjectGallery
						items={project.data.gallery}
						projectTitle={project.data.title}
					/>
				)
			}

			{
				!inline && project.data.models.length > 0 && (
					<ProjectModels items={project.data.models} />
				)
			}

			{
				!inline && project.data.videos.length > 0 && (
					<ProjectVideo items={project.data.videos} />
				)
			}

			{
				!inline && otherAudio.length > 0 && (
					<ProjectAudio items={otherAudio} />
				)
			}

			{
				!inline && (project.data.downloads.length > 0 || project.data.links.length > 0) && (
					<ProjectResources
						downloads={project.data.downloads}
						links={project.data.links}
					/>
				)
			}

			{
				!inline && project.data.codeSamples.length > 0 && (
					<ProjectCode items={project.data.codeSamples} />
				)
			}

			{!inline && project.data.shaderGraphs.length > 0 && <ProjectShaderGraphs items={project.data.shaderGraphs} />}
			<div class:list={["project-content", { "is-inline": inline }]}>
				<Content components={mediaComponents} />
			</div>
		</article>
		<RelatedProjects project={project} />
	</main>
</BaseLayout>

<style>
	.project-page {
		width: min(calc(100% - 2rem), var(--content-width));
		margin-inline: auto;
		padding-block: clamp(2rem, 6vw, 5rem);
	}

	.project-content > :global(.case-contents) {
		display: flex;
		flex-wrap: wrap;
		gap: .5rem 1.25rem;
		max-width: 70rem;
		margin: 0 auto 2.5rem;
		font-size: .85rem;
		line-height: 1.8;
	}
	.project-content :global(.case-contents a) { text-underline-offset: .3em; }
	@media (pointer: coarse) { .project-content :global(.case-contents a) { display: inline-flex; align-items: center; min-height: 2.75rem; } .project-content > :global(.case-contents) { gap: 0 1.25rem; } }

	.back-link {
		display: flex;
		width: fit-content;
		margin-left: max(0px, calc((100% - 70rem) / 2));
		align-items: center;
		gap: 0.4rem;
		color: var(--color-muted);
		font-size: var(--text-small);
		text-decoration: none;
	}

	.back-link:hover {
		text-decoration: underline;
	}

	.back-link:focus-visible {
		outline: 2px solid var(--color-accent);
		outline-offset: 0.25rem;
	}

	.project-header {
		display: grid;
		grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
		align-items: center;
		gap: var(--space-6);
		max-width: 70rem;
		margin-inline: auto;
		padding-block: clamp(2rem, 5vw, 3.5rem) clamp(2rem, 5vw, 3.5rem);
	}
	.project-header:not(:has(.key-preview)) { grid-template-columns: minmax(0, 1fr) auto; }
	.intro { display: grid; justify-items: start; gap: var(--space-3); min-width: 0; }
	.label a { display: inline-flex; align-items: center; gap: var(--space-2); color: var(--color-muted); text-decoration: none; }
	.label a:hover, .label a:focus-visible { color: var(--color-text); text-decoration: underline; text-underline-offset: 0.25rem; }
	h1 { margin: 0; font-size: var(--text-h1); line-height: 1.05; letter-spacing: -0.045em; overflow-wrap: anywhere; }
	.summary { max-width: 38rem; margin: 0; color: var(--color-muted); font-size: var(--text-lead); line-height: 1.55; }
	.facts { display: grid; gap: var(--space-2); margin: var(--space-2) 0 0; padding-top: var(--space-4); border-top: 1px dashed var(--color-border-strong); width: 100%; }
	.facts div { display: grid; grid-template-columns: 4.5rem minmax(0, 1fr); align-items: baseline; gap: var(--space-3); }
	.facts dt { color: var(--color-faint); font-family: var(--font-mono); font-size: var(--text-label); }
	.facts dd { margin: 0; color: var(--color-text); font-size: var(--text-small); }
	.facts ul { display: flex; flex-wrap: wrap; gap: var(--space-1) var(--space-2); margin: 0; padding: 0; list-style: none; }
	.facts li { padding: 0.05rem 0.5rem; border: 1px solid var(--color-border); border-radius: var(--radius-sm); color: var(--color-muted); font-size: var(--text-label); }
	.facts :global(.date-range) { border: 0; padding: 0; background: none; }
	.demo-label { padding: 0.2rem 0.6rem; border-radius: var(--radius-sm); background: var(--color-accent); color: var(--color-background); font-size: var(--text-label); font-weight: 700; }
	.key-preview { margin: 0; overflow: hidden; border: 1px solid var(--color-border); border-radius: var(--radius-md); background: var(--color-surface); box-shadow: var(--glow); }
	.key-preview :global(img) { display: block; width: 100%; height: auto; max-height: 32rem; object-fit: cover; }
	.project-header :global(.mark) { opacity: 0.55; }
	@media (max-width: 56rem) { .project-header, .project-header:not(:has(.key-preview)) { grid-template-columns: minmax(0, 1fr); } .project-header :global(.mark) { display: none; } }

	.project-content {
		max-width: 70rem;
		margin-inline: auto;
		padding-block: 2rem;
		border-top: 1px solid var(--color-border);
		font-size: 1rem;
		line-height: 1.75;
	}

	.project-content.is-inline {
		padding-top: 0;
		border-top: 0;
		display: flow-root;
	}

	.project-content.is-inline > :global(:first-child) {
		margin-top: 0;
	}

	.project-content > :global(:not(.inline-media):not(.project-media-group)) {
		max-width: 46rem;
		margin-inline: auto;
	}

	.project-content :global(.project-section-nav) {
		display: flex;
		flex-wrap: wrap;
		gap: .5rem;
		margin-block: 1.5rem 2rem;
	}
	.project-content :global(.project-section-nav a) {
		display: inline-flex;
		align-items: center;
		min-height: 2.75rem;
		max-width: 100%;
		padding: .45rem .8rem;
		border: 1px solid var(--color-border);
		border-radius: .6rem;
		color: var(--color-muted);
		font-size: .85rem;
		line-height: 1.4;
		text-decoration: none;
		overflow-wrap: anywhere;
	}
	.project-content :global(.project-section-nav a:hover),
	.project-content :global(.project-section-nav a:focus-visible) {
		color: var(--color-text);
		border-color: currentColor;
	}

	.project-content :global(.project-media-group) {
		display: grid;
		grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
		align-items: center;
		gap: clamp(1.5rem, 4vw, 3rem);
		margin-block: clamp(2.5rem, 6vw, 5rem);
	}
	.project-content :global(.project-media-group.is-reversed) { grid-template-columns: minmax(0, 1.2fr) minmax(0, .8fr); }
	.project-content :global(.is-reversed > .project-group-text) { grid-column: 2; grid-row: 1; }
	.project-content :global(.is-reversed > .project-group-media) { grid-column: 1; grid-row: 1; }

	.project-content :global(.project-media-group.media-only) {
		grid-template-columns: minmax(0, 1fr);
	}

	.project-content :global(.project-group-text),
	.project-content :global(.project-group-media) { min-width: 0; }
	.project-content :global(.project-group-text > :first-child),
	.project-content :global(.project-group-media > :first-child) { margin-top: 0; }
	.project-content :global(.project-group-text > :last-child),
	.project-content :global(.project-group-media > :last-child) { margin-bottom: 0; }

	@media (max-width: 800px) {
		.project-content :global(.project-media-group) {
			grid-template-columns: minmax(0, 1fr);
		}
		.project-content :global(.project-media-group.is-reversed) { grid-template-columns: minmax(0, 1fr); }
		.project-content :global(.is-reversed > .project-group-text),
		.project-content :global(.is-reversed > .project-group-media) { grid-column: auto; grid-row: auto; }
	}

	.project-content :global(h2) {
		scroll-margin-top: 6rem;
		margin: 3rem 0 1rem;
		font-size: clamp(1.4rem, 2.7vw, 2rem);
		line-height: 1.25;
		letter-spacing: -0.03em;
	}

	.project-content :global(p),
	.project-content :global(li) {
		color: var(--color-muted);
	}

	.project-content :global(blockquote) {
		margin: 0 0 1.5rem;
		padding: 1.25rem 1.5rem;
		color: var(--color-text);
		border-left: 0.2rem solid var(--color-accent);
		background: var(--color-surface);
	}

	.project-content :global(blockquote p) {
		margin: 0;
		color: inherit;
	}
</style>
