---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ProjectsByYear from "../../components/projects/ProjectsByYear.astro";
import { getCollection, type CollectionEntry } from "astro:content";
import { directions } from "../../data/directions";
import type { Direction } from "../../data/directions";
import { directionDoodles } from "../../data/doodles";
import Doodle from "../../components/ui/Doodle.astro";
import Icon from "../../components/ui/Icon.astro";
import SoftwareCatalog from "../../components/software/SoftwareCatalog.astro";
import { rankMap } from "../../data/rankings";

export async function getStaticPaths() {
	const projects = await getCollection("projects", ({ data }) => !data.draft);

	return directions.map((direction) => ({
		params: { slug: direction.slug },
		props: {
			direction,
			projects: projects.filter((project) => project.data.direction === direction.slug),
		},
	}));
}

interface Props {
	direction: Direction;
	projects: CollectionEntry<"projects">[];
}

const { direction, projects } = Astro.props;
const homeUrl = import.meta.env.BASE_URL;
const ranks = rankMap(projects);
const isSoftware = direction.slug === "software";
const doodle = directionDoodles[direction.slug];
---

<BaseLayout
	title={`${direction.title} | Camoka's Portfolio`}
	description={direction.description}
	lang="en"
>
	<main class="category-page container" id="main-content" tabindex="-1">
		<nav class="crumbs" aria-label="Breadcrumb">
			<a href={homeUrl}><Icon name="arrow-left" size={15} /> Back to home</a>
			<span aria-hidden="true">/</span>
			<a href={`${homeUrl}directions/`}>Directions</a>
		</nav>

		<header class="category-header">
			<div class="copy">
				<p class="label"><Icon name={direction.icon} size={14} /> {isSoftware ? "My toolkit" : "Creative direction"}</p>
				<h1>{direction.title}</h1>
				<p class="description">{direction.description}</p>
				{!isSoftware && <p class="label count">{projects.length} {projects.length === 1 ? "project" : "projects"}</p>}
			</div>
			{doodle && <Doodle name={doodle} width={120} flow class="mark" />}
		</header>

		{isSoftware ? <SoftwareCatalog /> : (
			<section aria-label="Projects">
				{projects.length > 0
					? <ProjectsByYear projects={projects} ranks={ranks} />
					: <p class="empty-message">Projects in this direction will appear here.</p>}
			</section>
		)}
	</main>
</BaseLayout>

<style>
	.category-page { padding-block: var(--space-5) var(--space-8); }
	.crumbs { display: flex; align-items: center; flex-wrap: wrap; gap: var(--space-2); color: var(--color-faint); font-size: var(--text-small); }
	.crumbs a { display: inline-flex; align-items: center; gap: var(--space-1); color: var(--color-muted); text-decoration: none; }
	.crumbs a:hover, .crumbs a:focus-visible { color: var(--color-text); text-decoration: underline; text-underline-offset: 0.25rem; }

	.category-header {
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		gap: var(--space-5);
		padding-block: var(--space-6) var(--space-6);
		margin-bottom: var(--space-6);
		border-bottom: 1px solid var(--color-border);
	}
	.copy { display: grid; gap: var(--space-2); min-width: 0; }
	.label { display: inline-flex; align-items: center; gap: var(--space-2); }
	h1 { margin: 0; font-size: var(--text-h1); line-height: 1.05; letter-spacing: -0.045em; }
	.description { max-width: 40rem; margin: 0; color: var(--color-muted); font-size: var(--text-lead); line-height: 1.55; }
	.category-header :global(.mark) { opacity: 0.6; flex: none; }
	.empty-message { padding: var(--space-5); border: 1px dashed var(--color-border-strong); border-radius: var(--radius-md); color: var(--color-muted); }
	@media (max-width: 36rem) { .category-header :global(.mark) { width: 4.5rem; } }
</style>
