---
import BaseLayout from "../layouts/BaseLayout.astro";
import DirectionTile from "../components/directions/DirectionTile.astro";
import ProjectCard from "../components/projects/ProjectCard.astro";
import Icon from "../components/ui/Icon.astro";
import Doodle from "../components/ui/Doodle.astro";
import SectionHeading from "../components/ui/SectionHeading.astro";
import AsciiRule from "../components/ui/AsciiRule.astro";
import { contactLinks } from "../data/contactLinks";
import { home } from "../data/home";
import { software, softwareLogo, softwareUrl } from "../data/software";
import { directionThumbs, highlights, listProjects, orderedDirections } from "../data/rankings";

const baseUrl = import.meta.env.BASE_URL;
const projects = await listProjects();
const featured = highlights(projects, home.pinnedProjects, home.highlightCount);
const topDirections = orderedDirections(projects)
	.filter((item) => item.count > 0 && item.slug !== "software")
	.slice(0, home.directionCount);
const tiles = await Promise.all(
	topDirections.map(async (item) => ({ ...item, thumbs: await directionThumbs(projects, item.slug) })),
);
const tools = software.filter((tool) => tool.status === "In use").slice(0, 10);
const [primaryContacts, secondaryContacts] = [contactLinks.slice(0, 2), contactLinks.slice(2)];
---

<BaseLayout title={home.pageTitle} description={home.pageDescription} lang="en">
	<main id="main-content" tabindex="-1">
		<section class="hero container" aria-labelledby="hero-title">
			<div class="hero-copy">
				<p class="label">~/{home.eyebrow}<span class="cursor" aria-hidden="true">_</span></p>
				<h1 id="hero-title">{home.name}</h1>
				<p class="alias">{home.alias}</p>
				<p class="lead">{home.heroLine}</p>
				<div class="actions">
					<a class="btn btn-primary" href="#featured"><Icon name="arrow-right" size={17} />{home.viewWork}</a>
					<a class="btn" href="#contact"><Icon name="mail" size={17} />{home.getInTouch}</a>
				</div>
			</div>

			<figure class="hero-art">
				<div class="frame">
					<span class="corner tl"></span><span class="corner tr"></span><span class="corner bl"></span><span class="corner br"></span>
					<Doodle name="author" width={260} flow eager class="author" />
					<Doodle name="stars" width={96} class="stars" />
				</div>
				<figcaption class="label">fig. 1 — {home.heroArtCaption}</figcaption>
			</figure>
		</section>

		<section id="featured" class="featured container" aria-labelledby="featured-title">
			<SectionHeading id="featured-title" index="01" title={home.featuredTitle} href={`${baseUrl}projects/`} linkLabel={home.allProjects} />
			<ul class="featured-grid">
				{featured.map((project, index) => <ProjectCard project={project} variant={index === 0 ? "feature" : "default"} />)}
			</ul>
		</section>

		<div class="container rule"><AsciiRule /></div>

		<section id="directions" class="directions container" aria-labelledby="directions-title">
			<SectionHeading id="directions-title" index="02" title={home.directionsTitle} href={`${baseUrl}directions/`} linkLabel={home.allDirections} />
			<ul class="tile-grid">
				{tiles.map((item) => <DirectionTile direction={item.direction} count={item.count} thumbs={item.thumbs} />)}
			</ul>
		</section>

		<section class="about container" aria-labelledby="about-title">
			<div class="about-grid">
				<div>
					<p class="label" aria-hidden="true">03</p>
					<h2 id="about-title">{home.aboutTitle}</h2>
				</div>
				<div class="about-text">
					<p class="lead">{home.aboutParagraphs[0]}</p>
					{home.aboutParagraphs.length > 1 && (
						<details>
							<summary>
								<span class="when-closed">{home.readMore}</span>
								<span class="when-open">{home.showLess}</span>
							</summary>
							{home.aboutParagraphs.slice(1).map((paragraph) => <p>{paragraph}</p>)}
						</details>
					)}
				</div>
			</div>
		</section>

		<section id="software" class="software container" aria-labelledby="software-title">
			<SectionHeading id="software-title" index="04" title={home.softwareTitle} href={`${baseUrl}directions/software/`} linkLabel={home.fullToolkit} />
			<ul class="tools">
				{tools.map((tool) => (
					<li>
						<a href={softwareUrl(tool.slug, baseUrl)}>
							<img src={softwareLogo(tool.slug, baseUrl)} alt="" width="22" height="22" loading="lazy" decoding="async" />
							<span>{tool.title}</span>
						</a>
					</li>
				))}
			</ul>
		</section>

		<section id="contact" class="contact container" aria-labelledby="contact-title">
			<div class="contact-box">
				<div class="contact-copy">
					<p class="label" aria-hidden="true">05</p>
					<h2 id="contact-title">{home.contactTitle}</h2>
					<p class="lead">{home.contactDescription}</p>
					<div class="actions">
						{primaryContacts.map((link, index) => (
							<a class:list={["btn", { "btn-primary": index === 0 }]} href={link.href} target={link.href.startsWith("mailto:") ? undefined : "_blank"} rel="noreferrer">
								<Icon name={link.icon} size={17} /><span class="btn-text">{link.label}</span><span class="detail">{link.detail}</span>
							</a>
						))}
					</div>
					<ul class="secondary">
						{secondaryContacts.map((link) => (
							<li><a class="link-arrow" href={link.href} target="_blank" rel="noreferrer"><Icon name={link.icon} size={15} />{link.label}<span class="detail">{link.detail}</span></a></li>
						))}
					</ul>
				</div>
				<div class="contact-art" aria-hidden="true">
					<Doodle name="signature-tilted" width={190} flow class="signature" />
					<Doodle name="ducks" width={92} flow class="ducks" />
				</div>
			</div>
		</section>
	</main>
</BaseLayout>

<style>
	main > section { scroll-margin-top: 5rem; }

	/* ---------- Hero ---------- */
	.hero {
		display: grid;
		grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
		align-items: center;
		gap: var(--space-6);
		padding-block: clamp(2.5rem, 7vw, 5.5rem) var(--space-7);
	}
	.hero-copy { display: grid; min-width: 0; justify-items: start; gap: var(--space-3); }
	.cursor { margin-left: 0.15em; animation: blink 1.1s steps(2, start) infinite; }
	h1 {
		margin: var(--space-3) 0 0;
		font-size: var(--text-display);
		line-height: 0.92;
		letter-spacing: -0.065em;
	}
	.alias { margin: 0; color: var(--color-muted); font-size: clamp(1.1rem, 2.4vw, 1.5rem); letter-spacing: -0.02em; }
	.lead { margin: var(--space-2) 0 0; max-width: 34rem; color: var(--color-muted); font-size: var(--text-lead); line-height: 1.55; }
	.actions { display: flex; flex-wrap: wrap; gap: var(--space-3); margin-top: var(--space-4); }

	.hero-art { margin: 0; display: grid; justify-items: center; gap: var(--space-3); }
	.frame {
		position: relative;
		display: grid;
		place-items: center;
		width: min(100%, 21rem);
		padding: var(--space-5) var(--space-5) 0;
		border: 1px solid var(--color-border);
		border-radius: var(--radius-sm);
		background:
			radial-gradient(circle at 1px 1px, rgb(244 241 232 / 0.1) 1px, transparent 1.5px) 0 0 / 14px 14px,
			var(--color-surface);
		overflow: hidden;
	}
	.frame :global(.author) { opacity: 0.95; width: min(100%, 14rem); height: auto; display: block; }
	.frame :global(.stars) { right: 0.75rem; top: 0.75rem; opacity: 0.55; width: 4rem; }
	.corner { position: absolute; width: 0.6rem; height: 0.6rem; border: 0 solid var(--color-text); opacity: 0.6; }
	.tl { left: 0.4rem; top: 0.4rem; border-width: 1px 0 0 1px; }
	.tr { right: 0.4rem; top: 0.4rem; border-width: 1px 1px 0 0; }
	.bl { left: 0.4rem; bottom: 0.4rem; border-width: 0 0 1px 1px; }
	.br { right: 0.4rem; bottom: 0.4rem; border-width: 0 1px 1px 0; }

	/* ---------- Sections ---------- */
	.featured, .directions, .software { padding-block: var(--space-6); }
	.rule { padding-block: var(--space-4); }

	/* Editorial grid: one large work, then a calm rhythm of equal ones. */
	.featured-grid, .tile-grid { display: grid; gap: var(--space-4); margin: 0; padding: 0; list-style: none; }
	.featured-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); --thumb-ratio: 16 / 10; }
	.featured-grid > :global(:first-child) { grid-column: 1 / -1; }

	.tile-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }

	/* ---------- About ---------- */
	.about { padding-block: var(--space-6); }
	.about-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 2fr); gap: var(--space-6); padding-top: var(--space-6); border-top: 1px solid var(--color-border); }
	h2 { margin: var(--space-1) 0 0; font-size: var(--text-h2); line-height: 1.15; letter-spacing: -0.03em; }
	.about-text .lead { margin: 0; color: var(--color-text); max-width: var(--measure); }
	details { margin-top: var(--space-4); max-width: var(--measure); }
	details p { margin: var(--space-3) 0 0; color: var(--color-muted); line-height: 1.7; }
	summary { display: inline-flex; align-items: center; gap: var(--space-2); cursor: pointer; list-style: none; color: var(--color-text); font-size: var(--text-small); font-weight: 650; text-decoration: underline; text-underline-offset: 0.3rem; text-decoration-color: var(--color-border-strong); }
	summary::-webkit-details-marker { display: none; }
	.when-open, details[open] .when-closed { display: none; }
	details[open] .when-open { display: inline; }

	/* ---------- Software ---------- */
	.tools { display: flex; flex-wrap: wrap; gap: var(--space-2); margin: 0; padding: 0; list-style: none; }
	.tools a { display: inline-flex; align-items: center; gap: var(--space-2); min-height: 2.5rem; padding: 0.35rem 0.8rem 0.35rem 0.55rem; border: 1px solid var(--color-border); border-radius: var(--radius-sm); background: var(--color-surface); color: var(--color-muted); font-size: var(--text-small); text-decoration: none; transition: border-color 160ms var(--ease), color 160ms var(--ease); }
	.tools a:hover, .tools a:focus-visible { border-color: var(--color-border-strong); color: var(--color-text); }
	.tools img { width: 1.5rem; height: 1.5rem; padding: 2px; object-fit: contain; border-radius: 0.25rem; background: var(--color-text); }

	/* ---------- Contact ---------- */
	.contact { padding-block: var(--space-6) var(--space-8); }
	.contact-box { display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: center; gap: var(--space-6); padding: clamp(1.5rem, 4vw, 3rem); border: 1px dashed var(--color-border-strong); border-radius: var(--radius-md); background: var(--color-surface); }
	.contact-copy { display: grid; justify-items: start; gap: var(--space-2); }
	.contact-copy .lead { max-width: 32rem; }
	.btn .detail { color: inherit; opacity: 0.65; font-weight: 450; font-family: var(--font-mono); font-size: var(--text-label); overflow-wrap: anywhere; }
	.secondary { display: flex; flex-wrap: wrap; gap: var(--space-2) var(--space-5); margin: var(--space-3) 0 0; padding: 0; list-style: none; }
	.secondary .link-arrow { color: var(--color-muted); font-weight: 500; gap: var(--space-2); }
	.secondary .detail { color: var(--color-faint); font-family: var(--font-mono); font-size: var(--text-label); }
	.contact-art { display: grid; justify-items: center; gap: var(--space-2); }
	.contact-art :global(.signature) { opacity: 0.8; }
	.contact-art :global(.ducks) { opacity: 0.6; }

	@keyframes blink { to { visibility: hidden; } }

	/* ---------- Responsive ---------- */
	@media (min-width: 56rem) {
		/* Feature spans the left two thirds over two rows; two cards stack beside it; three fill the last row. */
		.featured-grid { grid-template-columns: repeat(12, minmax(0, 1fr)); }
		.featured-grid > :global(:first-child) { grid-column: 1 / 9; grid-row: 1 / 3; }
		.featured-grid > :global(:nth-child(2)), .featured-grid > :global(:nth-child(3)) { grid-column: 9 / 13; }
		.featured-grid > :global(:nth-child(n + 4)) { grid-column: span 4; }
		.tile-grid { grid-template-columns: repeat(4, minmax(0, 1fr)); }
	}
	@media (max-width: 56rem) {
		.contact-box { grid-template-columns: 1fr; }
		.contact-art { grid-auto-flow: column; justify-content: start; align-items: end; }
		.about-grid { grid-template-columns: 1fr; gap: var(--space-3); }
	}
	@media (max-width: 36rem) {
		.tile-grid { grid-template-columns: 1fr; }
		/* Phones: one large work, then compact pairs. */
		.featured-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-3); --thumb-ratio: 4 / 3; }
		.hero { grid-template-columns: 1fr; position: relative; padding-top: var(--space-5); }
		.hero-art { position: absolute; right: 0; top: var(--space-4); }
		.hero-art figcaption { display: none; }
		.frame { width: 6.75rem; padding: var(--space-2) var(--space-2) 0; }
		.frame :global(.author) { width: 4.6rem; }
		.frame :global(.stars) { width: 1.9rem; right: 0.3rem; top: 0.3rem; }
		.corner { display: none; }
		h1 { font-size: clamp(3rem, 16vw, 4.25rem); }
	}
	@media (prefers-reduced-motion: reduce) {
		.cursor { animation: none; }
	}
</style>
