---
import "../styles/global.css";
import interLatin from "@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url";
import SiteFooter from "../components/layout/SiteFooter.astro";
import SiteHeader from "../components/layout/SiteHeader.astro";
import PageMetadata from "../components/layout/PageMetadata.astro";
import BackToTop from "../components/layout/BackToTop.astro";

interface Props {
	title: string;
	description: string;
	lang?: string;
	type?: "website" | "article";
	publishedAt?: Date;
	noindex?: boolean;
	image?: string;
}

const { title, description, lang = "en", type, publishedAt, noindex, image } = Astro.props;
const baseUrl = import.meta.env.BASE_URL;
import { localizedMedia } from "../data/localizedMedia";
const mediaVersions = localizedMedia();
import { getCollection } from "astro:content";
import { software, softwareUrl } from "../data/software";
const referenceProjects = await getCollection("projects", ({data}) => !data.draft);
const referenceTargets = Object.fromEntries([
	...referenceProjects.map(project => [project.id.toLowerCase(), baseUrl + "projects/" + project.id + "/"]),
	...software.map(tool => ["software/" + tool.slug, softwareUrl(tool.slug, baseUrl)]),
]);
---

<!doctype html>
<html lang={lang} data-language={lang}>
	<head>
		<script is:inline>
			let savedLanguage;
			try { savedLanguage = localStorage.getItem("portfolio-language"); } catch {}
			const preferred = (navigator.languages || [navigator.language])
				.map(value => value.toLowerCase().split("-")[0])
				.find(value => value === "en" || value === "ru") || "en";
			const language = savedLanguage === "ru" || savedLanguage === "en" ? savedLanguage : preferred;
			document.documentElement.lang = language;
			document.documentElement.dataset.language = language;
			try { localStorage.setItem("portfolio-language", language); } catch {}
		</script>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<PageMetadata title={title} description={description} lang={lang} type={type} publishedAt={publishedAt} noindex={noindex} image={image} />

		<link rel="preload" href={interLatin} as="font" type="font/woff2" crossorigin />
		<link rel="icon" type="image/png" sizes="32x32" href={`${baseUrl}favicon-32.png`} />
		<link rel="icon" type="image/png" sizes="192x192" href={`${baseUrl}icon-192.png`} />
		<link rel="apple-touch-icon" href={`${baseUrl}apple-touch-icon.png`} />
		<meta name="theme-color" content="#0f0f0e" />
		<link rel="icon" href={`${baseUrl}favicon.ico`} sizes="any" />

		<title>{title}</title>
	</head>

	<body>
		<a class="skip-link" href="#main-content">Skip to content</a>
		<SiteHeader />
		<slot />
		<SiteFooter />
		<BackToTop />
		<div hidden id="localized-media" data-versions={JSON.stringify(mediaVersions)}></div>
		<div hidden id="content-references" data-targets={JSON.stringify(referenceTargets)}></div>
		<script src="../scripts/language.ts"></script>
		<script src="../scripts/scrollReveal.ts"></script>
	</body>
</html>
